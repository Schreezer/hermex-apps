// Shared app-identity and signing defaults, attached to the project as the
// base configuration for both build configurations (Debug and Release).
//
// Contributors: never edit this file or project.pbxproj to sign with your own
// Apple team. Create Config/Local.xcconfig (gitignored) instead — see
// CONTRIBUTING.md ("Code signing for contributors").

DEVELOPMENT_TEAM = 6GYD9C9N6R
APP_IDENTIFIER_SUFFIX =
APP_BUNDLE_IDENTIFIER = com.uzairansar.hermesmobile$(APP_IDENTIFIER_SUFFIX)
APP_GROUP_IDENTIFIER = group.com.uzairansar.hermesmobile$(APP_IDENTIFIER_SUFFIX)

// Keychain access groups. The first entry of the entitlement's array is the
// app's *default* group, so KEYCHAIN_DEFAULT_ACCESS_GROUP must stay first and
// keep its current value: every credential saved before push existed lives
// there, and moving it would sign users out. KEYCHAIN_ACCESS_GROUP is the
// shared group the Notification Service Extension also joins, holding only the
// per-server push pairing keys.
KEYCHAIN_DEFAULT_ACCESS_GROUP = $(DEVELOPMENT_TEAM).$(APP_BUNDLE_IDENTIFIER)
KEYCHAIN_ACCESS_GROUP = $(DEVELOPMENT_TEAM).$(APP_BUNDLE_IDENTIFIER).push

// The embedded LiveContainer runtime is arm64-only (it uses ARM inline
// assembly), so simulator builds skip the Intel slice.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = x86_64

// LiveContainerSwiftUI is built with a bridging header that importing targets
// re-parse; the app and test targets add these to HEADER_SEARCH_PATHS.
HERMEX_LIVECONTAINER_HEADER_SEARCH_PATHS = $(SRCROOT)/Vendor/LiveContainer/LiveContainerSwiftUI/Models $(SRCROOT)/Vendor/LiveContainer/LiveContainerSwiftUI/Utilities $(SRCROOT)/Vendor/LiveContainer/LiveContainer $(SRCROOT)/Vendor/LiveContainer/MultitaskSupport

// Optional per-machine overrides. This include must stay last: later
// assignments win, so Local.xcconfig values override the defaults above.
#include? "Local.xcconfig"
